# API (redémarrer Metro après modification : npx expo start --dev-client -c)
#
# Dev distant (défaut en __DEV__) — si 502, le serveur dev est down côté infra
# EXPO_PUBLIC_API_URL=https://dev.api.municipall.dev/api/v1/
#
# Contournement : API prod (données réelles)
EXPO_PUBLIC_API_URL=https://api.municipall.dev/api/v1/
#
# Backend local (simulateur iOS)
# EXPO_PUBLIC_API_URL=http://127.0.0.1:3000/api/v1/

EXPO_PUBLIC_DEFAULT_TENANT_ID=le-kremlin-bicetre
# Obligatoire pour les notifications push (pas disponibles dans Expo Go SDK 53+).
#
# 1. npx eas login
# 2. npx eas init          → crée eas.json avec "projectId"
# 3. Copier l'UUID ici OU laisser eas.json (lu par app.config.js)
#
# EXPO_PUBLIC_EAS_PROJECT_ID=d2002388-14ed-4412-ba35-b6a8fc03fa94
#
# 4. Build sur téléphone :
#    npm run ios     ou    npm run android
# 5. Lancer Metro : npm run start:dev
# API (redémarrer Metro après modification : npx expo start --dev-client -c)
#
# Dev distant (défaut en __DEV__) — si 502, le serveur dev est down côté infra
# EXPO_PUBLIC_API_URL=https://dev.api.municipall.dev/api/v1/
#
# Contournement : API prod (données réelles)
EXPO_PUBLIC_API_URL=https://api.municipall.dev/api/v1/
#
# Backend local (simulateur iOS)
# EXPO_PUBLIC_API_URL=http://127.0.0.1:3000/api/v1/

EXPO_PUBLIC_DEFAULT_TENANT_ID=le-kremlin-bicetre

# --- iPhone avec compte Apple GRATUIT (Personal Team) ---
# Sans programme développeur payant (99 €/an), Apple refuse la capacité Push.
# Pour installer l’app sur ton iPhone en local :
IOS_PERSONAL_TEAM=1
# Optionnel si le bundle ID est déjà pris :
# IOS_BUNDLE_IDENTIFIER=com.tonnom.municipall.dev
