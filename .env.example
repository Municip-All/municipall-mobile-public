# Tenant par défaut (ville affichée si aucun choix utilisateur)
EXPO_PUBLIC_DEFAULT_TENANT_ID=le-kremlin-bicetre

# API base URL — surcharge le fallback dev/prod de constants/Config.ts
# Production (défaut) :
EXPO_PUBLIC_API_URL=https://api.municipall.dev/api/v1/
# Serveur de dev :
# EXPO_PUBLIC_API_URL=https://dev.api.municipall.dev/api/v1/
# Local backend (simulateur uniquement — utiliser l'IP LAN sur appareil physique) :
# EXPO_PUBLIC_API_URL=http://localhost:3002/api/v1/

# Notifications push (pas disponibles dans Expo Go SDK 53+) :
# 1. npx eas login
# 2. npx eas init          → crée eas.json avec "projectId"
# 3. Copier l'UUID ici OU laisser eas.json (lu par app.config.js)
# EXPO_PUBLIC_EAS_PROJECT_ID=d2002388-14ed-4412-ba35-b6a8fc03fa94

# Build sur téléphone :
#   npm run ios     ou    npm run android
# Lancer Metro : npm run start:dev

IOS_PERSONAL_TEAM=1
# IOS_BUNDLE_IDENTIFIER=com.tonnom.municipall.dev
